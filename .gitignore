# ============================================================
# solver-vgandolfi-dev — .gitignore raiz (monorepo)
# ============================================================

# --- Environment / segredos (NUNCA commitar) ---
.env
*.env
.env.*
!.env.example
!.env.sample

# --- Java / Maven (orchestrator) ---
target/
*.class
*.jar
*.war
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# IDE Java
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
HELP.md

# --- Python (worker) ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
venv/
.venv/
env/
ENV/
build/
dist/
*.log

# --- Node / React (web) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.rollup.cache/
.react-router/
build/

# --- Ferramentas ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Logs locais ---
logs/
*.log
nohup.out

# --- Docker ---
.dockerignore.local
docker-compose.override.yml

# --- Artefatos de ferramenta (sobras de migração) ---
.github/modernize/