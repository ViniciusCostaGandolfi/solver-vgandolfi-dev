# ============================================================
# solver-vgandolfi-dev — Exemplo de ambiente (.env.example)
# Copie para .env e ajuste:  cp .env.example .env
# NUNCA commite o .env real (segredos).
# ============================================================

# --- Spring profile ---
SPRING_PROFILES_ACTIVE=dev

# --- Banco de dados (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=solver-vgandolfi-dev
DB_USER=solver-vgandolfi-dev
DB_PASSWORD=solver-vgandolfi-dev

# --- RabbitMQ ---
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=solver-vgandolfi-dev
RABBIT_PASSWORD=solver-vgandolfi-dev

# --- Redis (rate limit) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- MinIO / S3 ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=solver-vgandolfi-dev

# --- URLs públicas ---
APP_BACKEND_URL=http://localhost:8080
VITE_API_URL=http://localhost:8080/api/v1

# --- Rate limit (por IP por minuto) ---
RATE_LIMIT_JOBS_PER_MINUTE=10
RATE_LIMIT_POLLS_PER_MINUTE=600

# --- Geocoding / integrações ---
NOMINATIM_URL=https://nominatim.rotaslivres.com.br
OPENCEP_URL=https://opencep.rotaslivres.com.br