# Worker Python - Environment Configuration (Example)
# Defaults for local docker-compose environment (docker-compose.yaml at repo root).
# Copy to .env and fill with real values. NEVER commit .env files.

# RabbitMQ
MQ_HOST=localhost
MQ_PORT=5672
MQ_USER=solver-vgandolfi-dev
MQ_PASSWORD=solver-vgandolfi-dev

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=solver-vgandolfi-dev
S3_REGION=us-east-1

# External integrations
OSRM_URL=https://osrm.rotaslivres.com.br
OSRM_VERIFY_SSL=False

# Solver tuning
VRP_TIMEOUT_SECONDS=600
LKH_MAX_ITERATIONS=30000
ALNS_ITERATIONS=1500
MAX_CONCURRENT_TSP=1
MAX_CONCURRENT_VRP=2
MAX_CONCURRENT_MATRIX=2